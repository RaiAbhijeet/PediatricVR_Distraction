<?xml version="1.0" encoding="utf-8"?>
<!--
    PediatricVR — AndroidManifest.xml
    
    Key additions over Unity default:
      - INTERNET + ACCESS_NETWORK_STATE + ACCESS_WIFI_STATE permissions
        (required for WebSocket server and IP detection)
      - android:usesCleartextTraffic="true"
        (required for ws:// not wss:// — plain WebSocket on hospital WiFi)
      - HOME + DEFAULT intent categories
        (makes app the default launcher — auto-starts on Quest boot)
      - networkSecurityConfig reference
        (Android 12+ requires explicit cleartext allowance)
    
    Place at: Assets/Plugins/Android/AndroidManifest.xml
    Unity merges this with its generated manifest at build time.
    
    If you also use Meta XR SDK — its OVRManifestPreprocessor will add
    the OVR-specific entries. This file adds only our custom overrides.
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.pediatricvr.distraction">

    <!-- ═══════════════════════════════════════════════════════
         PERMISSIONS
    ═══════════════════════════════════════════════════════ -->

    <!-- WebSocket server: bind to port, receive connections -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Local IP detection for displaying URL on idle screen -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Keeps network socket alive while screen is in use -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ═══════════════════════════════════════════════════════
         APPLICATION
    ═══════════════════════════════════════════════════════ -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:networkSecurityConfig,android:usesCleartextTraffic">

        <!--
            UnityPlayerGameActivity is the Unity 6 default activity class.
            If you are on an older Meta XR SDK that uses UnityPlayerActivity,
            change the android:name to com.unity3d.player.UnityPlayerActivity
        -->
        <activity
            android:name="com.unity3d.player.UnityPlayerGameActivity"
            android:theme="@style/PediatricVRActivityTheme"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:exported="true"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            tools:replace="android:screenOrientation,android:launchMode,android:resizeableActivity,android:theme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- Standard app launcher entry -->
                <category android:name="android.intent.category.LAUNCHER" />

                <!--
                    HOME + DEFAULT: makes this app the default launcher.
                    When the Quest boots, it opens THIS app instead of the Meta home shell.
                    Combined with ADB set-home-activity command in DEPLOYMENT_GUIDE.
                    
                    REMOVE THESE TWO LINES if you do NOT want auto-launch on boot,
                    or if the hospital procurement team requires the standard Meta shell.
                -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

    </application>

</manifest>
